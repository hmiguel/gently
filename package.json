{
  "name": "gently",
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "assets": "node scripts/render-assets.mjs",
    "release": "npm run build && cap sync android && cd android && ./gradlew bundleRelease assembleRelease",
    "screenshots": "node scripts/render-screenshots.mjs",
    "site:build": "vite build -c website/vite.config.ts && vite build -c website/vite.config.ts --ssr src/render.tsx --outDir .ssr && node website/prerender.mjs",
    "site:preview": "vite preview -c website/vite.config.ts --port 4173"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "license": "GPL-3.0-or-later",
  "private": true
}
